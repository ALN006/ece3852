namespace eval ip {

    # folder name Vivado uses for a packaged IP, e.g. hdmi_text_controller_1_0
    proc dir_name {name ver} {
        return ${name}_[string map {. _} $ver]
    }

    # Generate the AXI-Lite template (HDL + driver + bd.tcl). Returns the IP root folder.
    proc generate_stock_axi_lite_peripheral {name ver ip_repo tmp_dir part} {
        set ip_root $ip_repo/[dir_name $name $ver]

	#straight up delete an old stuff
        file delete -force $ip_root $tmp_dir
	file mkdir  $tmp_dir

        # create_peripheral needs an open project; this one is throwaway
        create_project -force tmp_ip_gen_prj $tmp_dir/tmp_ip_gen_prj -part $part

	#creates ip_root and lands there
        create_peripheral xilinx.com user $name $ver -dir $ip_repo
        set ip_ref [ipx::find_open_core xilinx.com:user:$name:$ver]

        add_peripheral_interface AXI -interface_mode slave -axi_type lite $ip_ref

	#genrate some useful files
        generate_peripheral -driver $ip_ref
        write_peripheral $ip_ref
	
	close_project
        return $ip_root
    }

    # Open the IP in an edit project and make it current.
    proc open_edit {name ip_root tmp_dir part} {
	#the spawning here is jank, look here first if things break
	create_project -force tmp_ip_edit_prj_host $tmp_dir/tmp_ip_edit_prj_host -part $part
        ipx::edit_ip_in_project -name tmp_ip_edit_prj -upgrade true -directory $tmp_dir $ip_root/component.xml
        current_project tmp_ip_edit_prj
    }
    # Swap template Verilog for our SystemVerilog in the edit PROJECT (not yet the packaged IP).
    proc swap_sources {name ver ip_root src_dir} {
        remove_files [get_files */hdl/*.v]
        file delete -force $ip_root/hdl

        file mkdir $ip_root/src
        foreach f [glob $src_dir/*.sv] { file copy -force $f $ip_root/src }
        add_files -norecurse [glob $ip_root/src/*.sv]

	set_property top ${name}_v[string map {. _} $ver] [current_fileset]
        update_compile_order -fileset sources_1
        ipx::merge_project_changes files [ipx::current_core]
	ipx::merge_project_changes ports [ipx::current_core]
    }
    # Bundle the TMDS ports into a master HDMI interface.
    # map = {logical_port physical_port ...}. Requires ports to be merged already.
    proc add_hdmi_interface {{map {TMDS_DATA_P hdmi_tx_p  TMDS_DATA_N hdmi_tx_n
                                   TMDS_CLK_P  hdmi_clk_p TMDS_CLK_N  hdmi_clk_n}}} {
        set core [ipx::current_core]

        # 1. every physical port must exist in the IP
        foreach {logical physical} $map {
            if {[llength [ipx::get_ports $physical -of_objects $core]] == 0} {
                error "ip::add_hdmi_interface: port '$physical' not in the IP (merge ports first)"
            }
        }

        # 2. remove interfaces Vivado inferred from the *_clk_* names; HDMI owns those ports
        set physicals [dict values $map]
        foreach bi [ipx::get_bus_interfaces -of_objects $core] {
            set n [get_property name $bi]
            if {$n in $physicals} { ipx::remove_bus_interface $n $core }
        }

        # 3. add the HDMI interface and map each logical port to its physical one
        ipx::add_bus_interface HDMI $core
        set hdmi [ipx::get_bus_interfaces HDMI -of_objects $core]
        set_property abstraction_type_vlnv xilinx.com:interface:hdmi_rtl:2.0 $hdmi
        set_property bus_type_vlnv         xilinx.com:interface:hdmi:2.0      $hdmi
        set_property interface_mode        master                             $hdmi
        set_property description           {HDMI output port}                 $hdmi

        foreach {logical physical} $map {
            ipx::add_port_map $logical $hdmi
            set_property physical_name $physical [ipx::get_port_maps $logical -of_objects $hdmi]
        }
    }
    # Overwrite the template driver sources with ours and drop the autogenerated selftest.
    # Requires the edit project to be current.
    proc import_driver {name ip_root drv_src_dir} {
        set drv [lindex [glob $ip_root/drivers/*/src] 0]

        foreach f {Makefile hdmi_text_controller.c hdmi_text_controller.h} {
            file copy -force $drv_src_dir/$f $drv/$f
        }

        # take the selftest out of the driver file group, then off disk
        set rel [string range $drv [expr {[string length $ip_root] + 1}] end]
        ipx::remove_file $rel/${name}_selftest.c \
            [ipx::get_file_groups xilinx_softwaredriver -of_objects [ipx::current_core]]
        file delete -force $drv/${name}_selftest.c
    }
    # Finalize the packaged IP and write it to disk. Run after all other edits.
    proc repackage {rev} {
        set core [ipx::current_core]
        set_property core_revision $rev $core
        ipx::update_source_project_archive -component $core
        ipx::create_xgui_files $core
        ipx::update_checksums $core
        ipx::check_integrity $core
        ipx::save_core $core
    }
}

